# Anthropic Claude API
ANTHROPIC_API_KEY=

# Google Search Console
GOOGLE_SERVICE_ACCOUNT_JSON=   # Base64-encoded service account JSON
GSC_PROPERTY_URL=               # e.g. https://yoursite.com

# Google Analytics 4 (not yet used)
GA4_PROPERTY_ID=

# HubSpot (not yet used)
HUBSPOT_API_KEY=

# Portfolio settings (used by apply-fixes and content pipeline)
PORTFOLIO_URL=https://yoursite.com
PORTFOLIO_REPO=your-github-username/your-portfolio-repo

# Note: GITHUB_TOKEN and PORTFOLIO_GITHUB_TOKEN are GitHub Actions secrets only.
# They are not needed locally — gh CLI handles auth for local runs.
